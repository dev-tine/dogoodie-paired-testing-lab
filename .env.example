# Public Supabase connection values. These are safe to expose to browser code
# because database and storage authorization is enforced with Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY and optional. Use only for explicitly approved administrative
# scripts. Never prefix this with NEXT_PUBLIC_ and never import it in a Client
# Component. Normal application requests must use the publishable key plus RLS.
SUPABASE_SERVICE_ROLE_KEY=
